{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveSplitSNES",
  "version": "1.0.0",
  "identifier": "com.livesplit.snes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "LiveSplit SNES",
        "width": 380,
        "height": 660,
        "minWidth": 280,
        "minHeight": 400,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
